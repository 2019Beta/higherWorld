{
  "schemaVersion": 1,
  "id": "higherworld",
  "version": "${version}",
  "name": "higherWorld",
  "description": "Sparse cubic world runtime with no dimension-configured build-height cap.",
  "authors": ["devt"],
  "contact": {},
  "license": "Unlicense",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "org.devt.higherworld.client.HigherworldDataGenerator"
    ],
    "client": [
      "org.devt.higherworld.client.HigherworldClient"
    ],
    "main": [
      "org.devt.higherworld.Higherworld"
    ]
  },
  "mixins": [
    "higherworld.mixins.json",
    {
      "config": "higherworld.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
